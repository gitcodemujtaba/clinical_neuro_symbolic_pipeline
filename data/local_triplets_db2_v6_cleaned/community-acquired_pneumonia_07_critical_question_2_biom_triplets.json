      "@id": "urn:uuid:a1b2c3d4-e5f6-7890-1234-567890abcdef",
      "@type": "Finding",
      "name": "Procalcitonin level",
      "snomed": "418752001",
      "icd10": "N/A",
      "provenance": {
        "source_document": "community-acquired_pneumonia_07_critical_question_2_biom.json",
        "section_title": "Critical Question 2: Biomarkers to Direct Initial Antimicrobial Therapy - Recommendations and Studies"
      },
      "rules": [
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:56c0e0c1-9379-4939-a31c-f8402e089eff",
          "rationale": "Procalcitonin is a biomarker released in response to bacterial infection and tissue injury, downregulated in viral infections.",
          "citation": "In 2017, a Class II Cochrane review by Schuetz et al evaluated the use of PCT on initiating or discontinuing antibiotics in patients with acute respiratory infections regarding mortality and treatment failure. In 2018, a large Class II randomized controlled trial by Huang et al (ProACT study) examined the effect of a PCT-based algorithm on antibiotic prescription in patients with suspected acute LRTI in the ED setting.",
          "citation_type": "pointer_unverifiable"
        }
      ]
    },
