      "rules": [
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:80a60121-ec6e-4d2c-a092-57e9d3eb0976",
          "rationale": "The guideline recommends against relying on current laboratory tests like procalcitonin and C-reactive protein to distinguish viral from bacterial pathogens when deciding on antimicrobial administration in ED patients with CAP.",
          "citation": "Level C recommendations. Do not rely upon any current laboratory test(s), such as procalcitonin [SNOMED: 418752001] and/or C-reactive protein [SNOMED: 61425002], to distinguish a viral pathogen [SNOMED: 264418008] from a bacterial pathogen [SNOMED: 264418008] when deciding on administration of antimicrobials in ED patients who have CAP.",
          "citation_type": "verbatim"
        }
      ]
    },
