    {
      "@id": "urn:uuid:1a2b3c4d-5e6f-7890-1234-567890abcdef",
      "@type": "Finding",
      "name": "C-reactive protein level",
      "snomed": "61425002",
      "icd10": "N/A",
      "provenance": {
        "source_document": "community-acquired_pneumonia_07_critical_question_2_biom.json",
        "section_title": "Critical Question 2: Biomarkers to Direct Initial Antimicrobial Therapy - Recommendations and Studies"
      },
      "rules": [
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:17d46978-3b09-457e-a0a5-024aa79103ce",
          "rationale": "C-reactive protein is a non-specific inflammatory biomarker that increases as a result of numerous infectious and noninfectious pathologies resulting in systemic inflammation.",
          "citation": "In 2017, a Class II Cochrane review by Schuetz et al evaluated the use of PCT on initiating or discontinuing antibiotics in patients with acute respiratory infections regarding mortality and treatment failure. Research involving CRP has investigated its use in differentiating bacterial from viral pneumonia.",
          "citation_type": "pointer_unverifiable"
        }
      ]
    },
