        "section_title": "Goal 15: The hospital identifies safety risks inherent in its patient population"
      },
      "rules": [
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:b2c3d4e5-f678-9012-3456-7890abcdef12",
          "rationale": "Patients identified as at risk for suicide require specific interventions to mitigate the risk.",
          "citation": "NPSG.15.01.01, EP 1-7",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_SCREENING",
          "target": "urn:uuid:1fd97dd6-0773-4a32-9857-3fc9d2e76164",
          "rationale": "All patients being evaluated or treated for behavioral health conditions as their primary reason for care should be screened for suicidal ideation.",
          "citation": "NPSG.15.01.01, EP 2",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_ASSESSMENT",
          "target": "urn:uuid:d2190b59-4d52-48f9-b4d3-4b2b266e0ede",
          "rationale": "Patients who screen positive for suicidal ideation require a suicide assessment.",
          "citation": "NPSG.15.01.01, EP 3",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_MONITORING",
          "target": "urn:uuid:7890abcd-ef12-3456-7890-abcdef123456",
          "rationale": "Implementation and effectiveness of policies and procedures for suicide risk management must be monitored.",
          "citation": "NPSG.15.01.01, EP 7",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_SCREENING",
          "target": "urn:uuid:1fd97dd6-0773-4a32-9857-3fc9d2e76164",
          "rationale": "Screen all patients for suicidal ideation who are being evaluated or treated for behavioral health conditions as their primary reason for care.",
          "citation": "NPSG.15.01.01, EP 2",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_ASSESSMENT",
          "target": "urn:uuid:d2190b59-4d52-48f9-b4d3-4b2b266e0ede",
          "rationale": "Use an evidence-based process to conduct a suicide assessment of patients who have screened positive for suicidal ideation.",
          "citation": "NPSG.15.01.01, EP 3",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_MONITORING",
          "target": "urn:uuid:7890abcd-ef12-3456-7890-abcdef123456",
          "rationale": "Monitor implementation and effectiveness of policies and procedures for screening, assessment, and management of patients at risk for suicide and take action as needed to improve compliance.",
          "citation": "NPSG.15.01.01, EP 7",
          "citation_type": "paraphrase"
        }
      ]
