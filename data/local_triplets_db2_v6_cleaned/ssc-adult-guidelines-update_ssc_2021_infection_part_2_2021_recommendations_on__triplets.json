    {
      "@id": "urn:uuid:a1b2c3d4-e5f6-7890-1234-567890abcdef",
      "@type": "Finding",
      "name": "Sepsis",
      "snomed": "91302008",
      "icd10": "N/A",
      "provenance": {
        "source_document": "ssc-adult-guidelines-update_ssc_2021_infection_part_2_2021_recommendations_on_.json",
        "section_title": "2021 RECOMMENDATIONS ON INFECTION 2/2"
      },
      "rules": [
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:b2c3d4e5-f678-9012-3456-7890abcdef12",
          "rationale": "Optimizing dosing strategies of antimicrobials based on PK/PD principles and specific drug properties is recommended for adults with sepsis or septic shock.",
          "citation": "For adults with sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007], we recommend optimising dosing strategies of antimicrobials based on accepted [SNOMED: 385645004] pharmacokinetic/pharmacodynamic (PK/PD) principles and specific drug properties [SNOMED: 118598001].",
          "citation_type": "verbatim"
        },
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:dd94673e-d59a-48e6-a55f-43431a41aa35",
          "rationale": "Rapidly identifying or excluding a specific anatomical diagnosis of infection that requires emergent source control and implementing any required source control intervention is recommended for adults with sepsis or septic shock.",
          "citation": "For adults with sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007], we recommend rapidly identifying or excluding a specific anatomical [SNOMED: 36298004] diagnosis [SNOMED: 887161000000102] of infection [SNOMED: 191415002] that requires emergent source control and implementing any required source control intervention as soon as medically and logistically practical.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:3847ad5f-fa9e-4c70-9f09-86f477f8397d",
          "rationale": "Prompt removal of intravascular access devices that are a possible source of sepsis or septic shock is recommended for adults with sepsis or septic shock after other vascular access has been established.",
          "citation": "For adults with sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007], we recommend prompt removal [SNOMED: 118292001] of intravascular [SNOMED: 261101003] access devices that are a possible source of sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007] after other vascular [SNOMED: 27550009] access has been established.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:b033f09f-7523-4b7a-9157-0e95b5ca0c9c",
          "rationale": "Daily assessment for de-escalation of antimicrobials over using fixed durations of therapy without daily reassessment is suggested for adults with sepsis or septic shock.",
          "citation": "For adults with sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007], we suggest daily assessment [SNOMED: 310243009] for de-escalation of antimicrobials over using fixed [SNOMED: 261010008] durations of therapy [SNOMED: 261773006] without daily reassessment for de-escalation.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:6f8095f0-13f0-463c-8e6d-005e1d846b79",
          "rationale": "Using shorter over longer duration of antimicrobial therapy is suggested for adults with an initial diagnosis of sepsis or septic shock and adequate source control.",
          "citation": "For adults with an initial diagnosis [SNOMED: 887161000000102] of sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007] and adequate source control, we suggest using shorter over longer duration [SNOMED: 272116003] of antimicrobial therapy.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "INDICATES",
          "target": "urn:uuid:8391ef6d-af32-4c05-af89-738c210a7935",
          "rationale": "Using procalcitonin AND clinical evaluation to decide when to discontinue antimicrobials over clinical evaluation alone is suggested for adults with an initial diagnosis of sepsis or septic shock and adequate source control where optimal duration of therapy is unclear.",
          "citation": "For adults with an initial diagnosis [SNOMED: 887161000000102] of sepsis [SNOMED: 91302008] or septic shock [SNOMED: 76571007] and adequate source control where optimal duration of therapy [SNOMED: 261773006] is unclear, we suggest using procalcitonin [SNOMED: 418752001] AND clinical evaluation [SNOMED: 386053000] to decide when to discontinue antimicrobials over clinical evaluation [SNOMED: 386053000] alone.",
          "citation_type": "verbatim"
        }
      ]
    },
