      "provenance": {
        "source_document": "gold-pocket-guide-2026-v1.1-20nov2025_wmv2_chunk_2_definition,_overview,_tr.json",
        "section_title": "Definition, Overview, Trajectories, and Etiotypes"
      },
      "rules": [
        {
          "predicate": "IS_A",
          "target": "urn:uuid:b2c3d4e5-f678-9012-3456-7890abcdef12",
          "rationale": "COPD is a heterogeneous lung condition.",
          "citation": "Definition section.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "HAS_CRITERION",
          "target": "urn:uuid:419c498a-b399-4b00-8005-6195f4387200",
          "rationale": "Diagnosis confirmed by non-fully reversible airflow obstruction (FEV1/FVC < 0.7 post-bronchodilation) measured by spirometry.",
          "citation": "Diagnostic Criteria section.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "HAS_ETIOLOGY",
          "target": "urn:uuid:ce65513a-4414-4008-93f3-a72701fcd04e",
          "rationale": "COPD can be genetically determined (Alpha-1 antitrypsin deficiency, other genetic variants).",
          "citation": "Proposed Taxonomy (Etiotypes) for COPD section.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "HAS_ETIOLOGY",
          "target": "urn:uuid:eb3fc19b-4c3c-4fe5-b02f-45fc133914c6",
          "rationale": "COPD can be due to abnormal lung development (Early life events, premature birth, low birthweight).",
          "citation": "Proposed Taxonomy (Etiotypes) for COPD section.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "HAS_ETIOLOGY",
          "target": "urn:uuid:eb061db5-4fab-47dd-ab1e-5f5d4135781c",
          "rationale": "COPD can be environmental (Cigarette smoking, Biomass and pollution exposure).",
          "citation": "Proposed Taxonomy (Etiotypes) for COPD section.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "HAS_ETIOLOGY",
          "target": "urn:uuid:9355a9e2-21fb-4426-9fb3-420d16aff66c",
          "rationale": "COPD can be due to infections (Childhood infections, TB-associated COPD, HIV-associated COPD).",
          "citation": "Proposed Taxonomy (Etiotypes) for COPD section.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "HAS_ETIOLOGY",
          "target": "urn:uuid:5941e069-f5db-441d-9d9c-3d9cf4bb2ccf",
          "rationale": "COPD can be associated with asthma (particularly childhood asthma).",
          "citation": "Proposed Taxonomy (Etiotypes) for COPD section.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "HAS_ETIOLOGY",
          "target": "urn:uuid:5546545d-7810-497d-a718-e4adb0ff454b",
          "rationale": "COPD can be of unknown cause.",
          "citation": "Proposed Taxonomy (Etiotypes) for COPD section.",
          "citation_type": "verbatim"
        },
        {
          "predicate": "HAS_CRITERION",
          "target": "urn:uuid:9bb07b93-2059-47de-bc80-fc59824b36a2",
          "rationale": "COPD is characterized by chronic respiratory symptoms (dyspnea, cough, sputum production and/or exacerbations).",
          "citation": "Definition section.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "HAS_CRITERION",
          "target": "urn:uuid:95ae0924-c0bf-4588-8749-fdffe9a349c1",
          "rationale": "COPD causes persistent, often progressive airflow obstruction.",
          "citation": "Definition section.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "HAS_CRITERION",
          "target": "urn:uuid:ae3b808e-3bdc-4add-91f7-55a9c913efaa",
          "rationale": "COPD results from gene-environment interactions.",
          "citation": "Causes and Risk Factors section.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "HAS_CRITERION",
          "target": "urn:uuid:886593f3-4062-430f-8c91-a3f7b35a6855",
          "rationale": "Main environmental exposures leading to COPD are tobacco smoking and inhalation of toxic particles/gases from pollution.",
          "citation": "Causes and Risk Factors section.",
          "citation_type": "paraphrase"
        }
      ]
    },
