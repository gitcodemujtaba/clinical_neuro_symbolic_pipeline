  "@graph": [
    {
      "@id": "urn:uuid:a7b8c9d0-e1f2-43a6-b5c7-89def0123456",
      "@type": "Condition",
      "name": "Septic shock",
      "snomed": "76571007",
      "icd10": "N/A",
      "provenance": {
        "source_document": "ssc-adult-guidelines-update_ssc_2021_additional_therapies_2021_recommendations_on_.json",
        "section_title": "2021 RECOMMENDATIONS ON ADDITIONAL THERAPIES"
      },
      "rules": [
        {
          "predicate": "REQUIRES_MEDICATION",
          "target": "urn:uuid:f8e9d7c6-b5a4-49d3-a2b1-0fedcba98765",
          "rationale": "For adults with septic shock and an ongoing requirement for vasopressor therapy, IV corticosteroids are suggested.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:3994160c-55d6-46e2-bb2d-8c5d06e6a641",
          "rationale": "For adults with sepsis or septic shock, a restrictive transfusion strategy is recommended.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:728cbbf6-1fc7-4003-a731-35a92d85bbce",
          "rationale": "For adults with sepsis or septic shock, pharmacologic VTE prophylaxis is recommended unless contraindicated.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:ea6744df-3d31-465f-9b64-9ebc7ab46f17",
          "rationale": "For adults with sepsis or septic shock, low molecular weight heparin is recommended over unfractionated heparin for VTE prophylaxis.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:a688bb82-2f31-4363-acd1-9f6d66ce4797",
          "rationale": "For adults with sepsis or septic shock and AKI, either continuous or intermittent renal replacement therapy is suggested.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:abcdef01-2345-6789-abcd-ef0123456789",
          "rationale": "For adults with sepsis or septic shock, initiating insulin therapy is recommended at a glucose level of >= 180mg/dL (10mmol/L).",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:b73356a9-2ac1-4642-ad40-c57d4a4cba84",
          "rationale": "For adults with sepsis or septic shock and AKI, with no definitive indications for renal replacement therapy, using renal replacement therapy is suggested against.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:728cbbf6-1fc7-4003-a731-35a92d85bbce",
          "rationale": "For adults with sepsis or septic shock, mechanical VTE prophylaxis in addition to pharmacological prophylaxis is suggested against.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:3994160c-55d6-46e2-bb2d-8c5d06e6a641",
          "rationale": "For adults with sepsis or septic shock, early initiation (within 72 hours) of enteral nutrition is suggested for patients who can be fed enterally.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:ea6744df-3d31-465f-9b64-9ebc7ab46f17",
          "rationale": "For adults with sepsis or septic shock, using stress ulcer prophylaxis is suggested for those with risk factors for GI bleeding.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:a688bb82-2f31-4363-acd1-9f6d66ce4797",
          "rationale": "For adults with sepsis or septic shock, using sodium bicarbonate therapy is suggested for severe metabolic acidemia (pH <= 7.2) and AKI (AKIN score 2 or 3).",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:abcdef01-2345-6789-abcd-ef0123456789",
          "rationale": "For adults with sepsis or septic shock, using sodium bicarbonate therapy is suggested against to improve hemodynamics or reduce vasopressor requirements in hypoperfusion-induced lactic acidemia.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:b73356a9-2ac1-4642-ad40-c57d4a4cba84",
          "rationale": "For adults with sepsis or septic shock, using IV vitamin C is suggested against.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:728cbbf6-1fc7-4003-a731-35a92d85bbce",
          "rationale": "For adults with sepsis or septic shock, using polymyxin B hemoperfusion is suggested against.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:ea6744df-3d31-465f-9b64-9ebc7ab46f17",
          "rationale": "For adults with sepsis or septic shock, using other blood purification techniques is not recommended due to insufficient evidence.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        },
        {
          "predicate": "REQUIRES_INTERVENTION",
          "target": "urn:uuid:a688bb82-2f31-4363-acd1-9f6d66ce4797",
          "rationale": "For adults with sepsis or septic shock, using intravenous immunoglobulins is suggested against.",
          "citation": "Guideline recommendation.",
          "citation_type": "paraphrase"
        }
      ]
    },
